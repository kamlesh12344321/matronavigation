<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Train-Mounted Telemetry Box (ZUPT &amp; SpatiaLite)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Initialized"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for telemetry..."
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLogFilePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log File: --"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#0288D1"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSimulateMove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simulate Rail Motion"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnStartLogging"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Start Logging" />

        <Button
            android:id="@+id/btnStopLogging"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Stop Logging" />
    </LinearLayout>

</LinearLayout>
