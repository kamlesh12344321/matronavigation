<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS &amp; Network Simulation Dashboard"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Network & GPS Modes Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Simulation Mode"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbModeNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Mode 1: Normal GPS &amp; Network"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbModeFlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mode 2: Flight Mode (Offline)"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbModeLowNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mode 3: Low Network (Simulated Latency)"
                        android:textSize="14sp" />

                </RadioGroup>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Status Dashboard Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Status Dashboard"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvActiveMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Active Mode: Normal"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GPS / Dead Reckoning: GPS Active (Normal)"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvNetworkStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Network Simulation: Online (0ms Latency)"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCoordsSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coordinates &amp; Speed: 12.9716, 77.5946 | 0.0 m/s"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCacheStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Route Cache Status: Cache Miss (Fresh Query)"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Simulation Controls Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulation, Logging &amp; Verification Actions"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvLogFilePath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log File: --"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="#0288D1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnStartLogging"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Start Logging"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStopLogging"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Stop Logging"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSimulateLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simulate Location &amp; Route Lookup"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnVerifyCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verify Offline Cache &amp; Fallback"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Verification Logs" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Verification Logs Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verification Logs &amp; Confidence Scoring"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:text="System ready for testing across network conditions.\n"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="#222222"
                    android:scrollbars="vertical"
                    android:background="#EFEFEF"
                    android:padding="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
